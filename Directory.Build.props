<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">rc.1</VersionSuffix>
    <CSweetSatelliteOfficeContractsRepositoryRoot Condition="'$(CSweetSatelliteOfficeContractsRepositoryRoot)' == ''">$(MSBuildThisFileDirectory)..\CSweet.SatelliteOffice.Contracts</CSweetSatelliteOfficeContractsRepositoryRoot>
    <UseLocalSatelliteOfficeContracts Condition="'$(UseLocalSatelliteOfficeContracts)' == '' and Exists('$(CSweetSatelliteOfficeContractsRepositoryRoot)\src\CSweet.SatelliteOffice.Contracts\CSweet.SatelliteOffice.Contracts.csproj')">true</UseLocalSatelliteOfficeContracts>
    <UseLocalSatelliteOfficeContracts Condition="'$(UseLocalSatelliteOfficeContracts)' == ''">false</UseLocalSatelliteOfficeContracts>
  </PropertyGroup>
</Project>
