<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Private local RPC contracts between the Satellite Office node and privileged RuntimeHost.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
    <PackageReference Include="Grpc.Core.Api" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="runtime_host.proto" GrpcServices="None" />
  </ItemGroup>
</Project>
