{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c-sweet.com/schemas/office-release-v1.json",
  "title": "C-Sweet Office release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "officeVersion", "contractsVersion", "protocolVersion", "assets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "officeVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "contractsVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "protocolVersion": { "type": "string", "minLength": 1, "maxLength": 32 },
    "assets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["operatingSystem", "architecture", "packageType", "url", "size", "sha256", "signature", "guestImageDigest", "certificationValidUntil"],
        "properties": {
          "operatingSystem": { "enum": ["windows", "linux", "macos"] },
          "architecture": { "enum": ["x64", "arm64"] },
          "packageType": { "enum": ["msi", "deb", "rpm", "pkg"] },
          "url": { "type": "string", "pattern": "^https://github\\.com/CrosswiredStudios/CSweet\\.Office/releases/download/v[0-9]+\\.[0-9]+\\.[0-9]+/" },
          "size": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "signature": { "type": "object", "required": ["kind", "keyId"], "properties": { "kind": { "type": "string" }, "keyId": { "type": "string" }, "timestamp": { "type": ["string", "null"] } } },
          "guestImageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "certificationValidUntil": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
