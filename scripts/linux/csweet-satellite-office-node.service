[Unit]
Description=C-Sweet Satellite Office node
After=network-online.target csweet-satellite-office-runtime.service
Wants=network-online.target
Requires=csweet-satellite-office-runtime.service

[Service]
Type=notify
User=csweet-node
Group=csweet-node
SupplementaryGroups=csweet-runtime
EnvironmentFile=/etc/csweet/satellite-office.env
ExecStart=/opt/csweet/satellite-office/CSweet.SatelliteOffice.Node
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/csweet/satellite-office /var/lib/csweet/artifact-media /run/csweet

[Install]
WantedBy=multi-user.target
