[Unit]
Description=C-Sweet Office privileged runtime
After=local-fs.target

[Service]
Type=notify
User=root
Group=csweet-runtime
ExecStartPre=/usr/sbin/csweet-office-start --verify
ExecStart="__OFFICE_INSTALL_ROOT__/CSweet.Office.RuntimeHost"
EnvironmentFile=/etc/csweet/runtime-host.env
Environment="CSweet__Office__Providers__Firecracker__ArtifactImageRoot=__OFFICE_ARTIFACT_ROOT__"
Environment="CSweet__Office__Providers__Firecracker__PayloadManifestPath=__OFFICE_INSTALL_ROOT__/runtime-manifest.json"
Environment="CSweet__Office__RuntimeHost__Authentication__SharedKeyFilePath=__OFFICE_DATA_ROOT__/runtime-host.key"
Environment="CSweet__Office__RuntimeHost__Authorization__StateDirectory=__OFFICE_DATA_ROOT__/authorization"
Restart=on-failure
RestartSec=5
RuntimeDirectory=csweet
RuntimeDirectoryMode=0770
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=no
Delegate=yes
DevicePolicy=closed
DeviceAllow=/dev/kvm rw
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETGID CAP_SETUID CAP_SYS_ADMIN CAP_SYS_CHROOT CAP_MKNOD CAP_KILL
ReadWritePaths="__OFFICE_DATA_ROOT__" "__OFFICE_ARTIFACT_ROOT__" /run/csweet /sys/fs/cgroup
UMask=0007

[Install]
WantedBy=multi-user.target
