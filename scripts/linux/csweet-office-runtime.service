[Unit]
Description=C-Sweet Office privileged runtime
After=local-fs.target

[Service]
Type=notify
User=root
Group=csweet-runtime
ExecStart=/opt/csweet/office/CSweet.Office.RuntimeHost
EnvironmentFile=/etc/csweet/runtime-host.env
Environment=CSweet__Office__Providers__Firecracker__ArtifactImageRoot=/var/lib/csweet/artifact-media
Environment=CSweet__Office__Providers__Firecracker__PayloadManifestPath=/opt/csweet/office/runtime-manifest.json
Environment=CSweet__Office__RuntimeHost__Authentication__SharedKeyFilePath=/var/lib/csweet/office/runtime-host.key
Environment=CSweet__Office__RuntimeHost__Authorization__StateDirectory=/var/lib/csweet/office/authorization
Restart=on-failure
RestartSec=5
RuntimeDirectory=csweet
RuntimeDirectoryMode=0770
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=no
Delegate=yes
DevicePolicy=closed
DeviceAllow=/dev/kvm rw
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETGID CAP_SETUID CAP_SYS_ADMIN CAP_SYS_CHROOT CAP_MKNOD CAP_KILL
ReadWritePaths=/var/lib/csweet/office /var/lib/csweet/artifact-media /run/csweet /sys/fs/cgroup
UMask=0007

[Install]
WantedBy=multi-user.target
