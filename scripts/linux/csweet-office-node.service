[Unit]
Description=C-Sweet Office node
After=network-online.target csweet-office-runtime.service
Wants=network-online.target
Requires=csweet-office-runtime.service

[Service]
Type=notify
User=csweet-node
Group=csweet-node
SupplementaryGroups=csweet-runtime
EnvironmentFile=/etc/csweet/office.env
# Verify mounted storage outside the node's private /dev namespace; this command only reads state.
ExecStartPre=+/usr/sbin/csweet-office-start --verify
ExecStart="__OFFICE_INSTALL_ROOT__/CSweet.Office.Node"
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths="__OFFICE_DATA_ROOT__" "__OFFICE_ARTIFACT_ROOT__" /run/csweet

[Install]
WantedBy=multi-user.target
